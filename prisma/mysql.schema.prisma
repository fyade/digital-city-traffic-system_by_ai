}

// 1.5 代码生成-列信息表
model sys_code_gen_column {
  id           Int                @id @default(autoincrement()) @dbMysql.Int
  table_id     Int                @dbMysql.Int
  col_name     String             @dbMysql.VarChar(60)
  col_descr    String             @dbMysql.VarChar(60)
  mysql_type   String             @dbMysql.VarChar(60)
  mysql_length Int                @dbMysql.Int
  ts_type      String             @dbMysql.VarChar(10)
  ts_name      String             @dbMysql.VarChar(60)
  if_ins       String             @dbMysql.Char(1)
  if_upd       String             @dbMysql.Char(1)
  if_sel_one   String             @dbMysql.Char(1)
  if_sel_more  String             @dbMysql.Char(1)
  if_required  String             @dbMysql.Char(1)
  sel_type     String             @dbMysql.VarChar(10)
  form_type    String             @dbMysql.VarChar(20)
  order_num    Int                @dbMysql.Int
  remark       String?            @dbMysql.VarChar(300)
  create_role  String             @dbMysql.VarChar(30)
  update_role  String             @dbMysql.VarChar(30)
  create_by    String             @dbMysql.VarChar(10)
  update_by    String             @dbMysql.VarChar(10)
  create_time  DateTime           @default(now())
  update_time  DateTime           @updatedAt
  deleted      String             @default("N") @dbMysql.Char(1)
  table_id_    sys_code_gen_table @relation(fields: [table_id], references: [id])
}

