generator clientMysql {
  provider        = "prisma-client-js"
  output          = "../prisma-generated/client-mysql"
  previewFeatures = ["prismaSchemaFolder"]
  binaryTargets   = ["darwin", "windows", "linux-musl", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource dbMysql {
  provider = "mysql"
  url      = "mysql://root:123456@localhost:3306/proj_digital-city-traffic-system"
}

// 1.0 系统配置
model sys_config {
  id                   Int      @id @default(autoincrement()) @dbMysql.Int
  if_allow_user_regist String   @dbMysql.Char(1)
  remark               String?  @dbMysql.VarChar(300)
  create_role          String   @dbMysql.VarChar(30)
  update_role          String   @dbMysql.VarChar(30)
  create_by            String   @dbMysql.VarChar(10)
  update_by            String   @dbMysql.VarChar(10)
  create_time          DateTime @default(now())
  update_time          DateTime @updatedAt
  deleted              String   @default("N") @dbMysql.Char(1)
}

// 1.1 用户表
model sys_user {
  id             String          @id @dbMysql.VarChar(10)
  username       String          @dbMysql.VarChar(50)
  nickname       String?         @dbMysql.VarChar(50)
  password       String          @dbMysql.VarChar(100)
  avatar         String?         @dbMysql.VarChar(200)
  sex            String?         @dbMysql.VarChar(10)
  email          String?         @dbMysql.VarChar(50)
  tel            String?         @dbMysql.VarChar(15)
  create_role    String          @dbMysql.VarChar(30)
  update_role    String          @dbMysql.VarChar(30)
  create_by      String          @dbMysql.VarChar(10)
  update_by      String          @dbMysql.VarChar(10)
  create_time    DateTime        @default(now())
  update_time    DateTime        @updatedAt
  deleted        String          @default("N") @dbMysql.Char(1)
  sys_admin_tops sys_admin_top[]
}

