// 1.4 代码生成-表信息表
model sys_code_gen_table {
  id                   Int                   @id @default(autoincrement()) @dbMysql.Int
  table_name           String                @dbMysql.VarChar(60)
  table_descr          String                @dbMysql.VarChar(100)
  entity_name          String                @dbMysql.VarChar(60)
  table_remark         String?               @dbMysql.VarChar(300)
  business_name        String                @dbMysql.VarChar(60)
  module_name          String                @dbMysql.VarChar(60)
  business_name_cn     String                @dbMysql.VarChar(60)
  module_name_cn       String                @dbMysql.VarChar(60)
  sys_id               Int                   @dbMysql.Int
  order_num            Int                   @dbMysql.Int
  remark               String?               @dbMysql.VarChar(300)
  create_role          String                @dbMysql.VarChar(30)
  update_role          String                @dbMysql.VarChar(30)
  create_by            String                @dbMysql.VarChar(10)
  update_by            String                @dbMysql.VarChar(10)
  create_time          DateTime              @default(now())
  update_time          DateTime              @updatedAt
  deleted              String                @default("N") @dbMysql.Char(1)
  sys_                 sys_sys               @relation(fields: [sys_id], references: [id])
