  update_by     String   @dbPostgresql.VarChar(10)
  create_time   DateTime @default(now()) @dbPostgresql.Timestamptz(6)
  update_time   DateTime @default(now()) @dbPostgresql.Timestamptz(6)
  deleted       String   @default("N") @dbPostgresql.Char(1)
  strategy_type String   @dbPostgresql.VarChar(100)
  if_disabled   String   @dbPostgresql.Char(1)
  order_num     Int
  remark        String?  @dbPostgresql.VarChar(300)
  schedule_type String   @dbPostgresql.VarChar(30)
  start_time    DateTime @dbPostgresql.Timestamptz(6)
  end_time      DateTime @dbPostgresql.Timestamptz(6)
}

