generator clientPostgresql {
  provider        = "prisma-client-js"
  output          = "../prisma-generated/client-postgresql"
  previewFeatures = ["prismaSchemaFolder"]
  binaryTargets   = ["darwin", "windows", "linux-musl", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource dbPostgresql {
  provider = "postgresql"
  url      = "postgresql://postgres:123456@localhost:5432/digital-city-traffic-system?schema=public"
}

model osm2pgsql_properties {
  property String @id
  value    String
}

model planet_osm_nodes {
  id   BigInt @id
  lat  Int
  lon  Int
  tags Json?
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model planet_osm_rels {
  id      BigInt @id
  members Json
  tags    Json?
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model planet_osm_ways {
  id    BigInt   @id
  nodes BigInt[]
  tags  Json?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @dbPostgresql.VarChar(256)
  auth_srid Int?
  srtext    String? @dbPostgresql.VarChar(2048)
  proj4text String? @dbPostgresql.VarChar(2048)
}
