<StyledLayerDescriptor version="1.0.0"
                       xmlns="http://www.opengis.net/sld"
                       xmlns:ogc="http://www.opengis.net/ogc"
                       xmlns:xlink="http://www.w3.org/1999/xlink">

    <NamedLayer>
        <Name>road_network</Name>
        <UserStyle>
            <Title>Advanced Road Style</Title>
            <Abstract>Style for road network with different classes and direction indicators</Abstract>

            <!-- 规则1：高速公路（motorway） -->
            <FeatureTypeStyle>
                <Rule>
                    <Name>Motorway</Name>
                    <ogc:Filter>
                        <ogc:PropertyIsEqualTo>
                            <ogc:PropertyName>highway</ogc:PropertyName>
                            <ogc:Literal>motorway</ogc:Literal>
                        </ogc:PropertyIsEqualTo>
                    </ogc:Filter>
                    <!-- 红色粗线 + 标签 -->
                    <LineSymbolizer>
                        <Stroke>
                            <CssParameter name="stroke">#E31A1C</CssParameter>
                            <CssParameter name="stroke-width">4</CssParameter>
                        </Stroke>
                    </LineSymbolizer>
                    <TextSymbolizer>
                        <Label>
                            <ogc:PropertyName>name</ogc:PropertyName>
                        </Label>
                        <Font>
                            <CssParameter name="font-family">Arial</CssParameter>
                            <CssParameter name="font-size">10</CssParameter>
                            <CssParameter name="font-weight">bold</CssParameter>
                        </Font>
                        <LabelPlacement>
                            <LinePlacement/>
                        </LabelPlacement>
                        <Fill>
                            <CssParameter name="fill">#FFFFFF</CssParameter> <!-- 白色文字 -->
                        </Fill>
                        <VendorOption name="followLine">true</VendorOption>
                        <VendorOption name="maxAngleDelta">30</VendorOption>
                        <VendorOption name="repeat">200</VendorOption> <!-- 标签重复间隔 -->
                    </TextSymbolizer>
                </Rule>
            </FeatureTypeStyle>

            <!-- 规则2：主干道（primary） -->
            <FeatureTypeStyle>
                <Rule>
                    <Name>Primary Road</Name>
                    <ogc:Filter>
                        <ogc:Or>
                            <ogc:PropertyIsEqualTo>
                                <ogc:PropertyName>highway</ogc:PropertyName>
                                <ogc:Literal>primary</ogc:Literal>
                            </ogc:PropertyIsEqualTo>
                            <ogc:PropertyIsEqualTo>
                                <ogc:PropertyName>highway</ogc:PropertyName>
                                <ogc:Literal>trunk</ogc:Literal>
                            </ogc:PropertyIsEqualTo>
                        </ogc:Or>
                    </ogc:Filter>
                    <!-- 橙色中线 -->
                    <LineSymbolizer>
                        <Stroke>
                            <CssParameter name="stroke">#FD8D3C</CssParameter>
                            <CssParameter name="stroke-width">3</CssParameter>
                        </Stroke>
                    </LineSymbolizer>
                    <!-- 标签（同高速公路） -->
                    <TextSymbolizer>
                        <Label>
                            <ogc:PropertyName>name</ogc:PropertyName>
                        </Label>
                        <Font>
                            <CssParameter name="font-family">Arial</CssParameter>
                            <CssParameter name="font-size">10</CssParameter>
                            <CssParameter name="font-weight">bold</CssParameter>
                        </Font>
                        <LabelPlacement>
                            <LinePlacement/>
                        </LabelPlacement>
                        <Fill>
                            <CssParameter name="fill">#FFFFFF</CssParameter>
                        </Fill>
                        <VendorOption name="followLine">true</VendorOption>
                        <VendorOption name="maxAngleDelta">30</VendorOption>
                        <VendorOption name="repeat">200</VendorOption>
                    </TextSymbolizer>
                </Rule>
            </FeatureTypeStyle>

            <!-- 规则3：次干道（secondary） -->
            <FeatureTypeStyle>
                <Rule>
                    <Name>Secondary Road</Name>
                    <ogc:Filter>
                        <ogc:PropertyIsEqualTo>
                            <ogc:PropertyName>highway</ogc:PropertyName>
                            <ogc:Literal>secondary</ogc:Literal>
                        </ogc:PropertyIsEqualTo>
                    </ogc:Filter>
                    <!-- 黄色细线 -->
                    <LineSymbolizer>
                        <Stroke>
                            <CssParameter name="stroke">#FECC5C</CssParameter>
                            <CssParameter name="stroke-width">2</CssParameter>
                        </Stroke>
                    </LineSymbolizer>
                </Rule>
            </FeatureTypeStyle>

            <!-- 规则4：单向道路箭头（需数据有oneway=yes字段） -->
            <FeatureTypeStyle>
                <Rule>
                    <Name>Oneway Direction</Name>
                    <ogc:Filter>
                        <ogc:PropertyIsEqualTo>
                            <ogc:PropertyName>oneway</ogc:PropertyName>
                            <ogc:Literal>yes</ogc:Literal>
                        </ogc:PropertyIsEqualTo>
                    </ogc:Filter>
                    <!-- 蓝色箭头符号 -->
                    <LineSymbolizer>
                        <Stroke>
                            <GraphicStroke>
                                <Graphic>
                                    <ExternalGraphic>
                                        <OnlineResource xlink:href="http://maps.google.com/mapfiles/kml/arrow.png"/>
                                        <Format>image/png</Format>
                                    </ExternalGraphic>
                                    <Size>10</Size>
                                </Graphic>
                            </GraphicStroke>
                            <CssParameter name="stroke">#0868AC</CssParameter>
                        </Stroke>
                    </LineSymbolizer>
                </Rule>
            </FeatureTypeStyle>

            <!-- 规则5：其他道路（默认样式） -->
            <FeatureTypeStyle>
                <Rule>
                    <Name>Other Roads</Name>
                    <ElseFilter/> <!-- 匹配所有未命中的道路 -->
                    <LineSymbolizer>
                        <Stroke>
                            <CssParameter name="stroke">#CCCCCC</CssParameter>
                            <CssParameter name="stroke-width">1</CssParameter>
                        </Stroke>
                    </LineSymbolizer>
                </Rule>
            </FeatureTypeStyle>
        </UserStyle>
    </NamedLayer>
</StyledLayerDescriptor>
