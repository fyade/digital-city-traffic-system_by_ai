{
  "name": "dcts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "[dev] [admin ] dev": "cross-env NODE_ENV=dev pnpm --filter @dcts/admin dev",
    "[dev] [server] start": "cross-env NODE_ENV=dev pnpm --filter @dcts/server start",
    "[dev] [server] start:dev": "cross-env NODE_ENV=dev pnpm --filter @dcts/server start:dev",
    "[dev] [server] start:debug": "cross-env NODE_ENV=dev pnpm --filter @dcts/server start:debug",
    "[build] [config] build": "pnpm -filter @dcts/config build",
    "[build] [common] build": "pnpm -filter @dcts/common build",
    "[build] [config & common]": "pnpm -filter @dcts/config build && pnpm -filter @dcts/common build",
    "[build] [admin ] build:prod": "cross-env NODE_ENV=prod pnpm --filter @dcts/admin build:prod",
    "[build] [server] build:wp": "pnpm generate:prisma && cross-env NODE_ENV=prod pnpm --filter @dcts/server build:wp",
    "[build] all": "pnpm \"[build] [config & common]\" && pnpm \"[build] [server] build:wp\" && pnpm \"[build] [admin ] build:prod\"",
    "generate:prisma": "pnpm generate:prisma:mysql && pnpm generate:prisma:postgresql",
    "generate:prisma:mysql": "npx prisma generate --schema=./prisma/schema.prisma",
    "generate:prisma:postgresql": "npx prisma generate --schema=./prisma/postgresql.schema.prisma"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@10.13.0",
  "dependencies": {
    "@dcts/common": "workspace:^",
    "@dcts/config": "workspace:^",
    "@element-plus/icons-vue": "^2.3.1",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.11.1",
    "alova": "^3.3.4",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.2",
    "cesium": "^1.131.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cron": "^3.5.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "element-plus": "^2.10.3",
    "exceljs": "^4.4.0",
    "ioredis": "^5.6.1",
    "mitt": "^3.0.1",
